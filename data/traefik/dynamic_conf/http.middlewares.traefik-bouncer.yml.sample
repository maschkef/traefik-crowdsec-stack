http:
  middlewares:
    traefik-bouncer:
      # angepasst: nativer Traefik-Plugin-Bouncer statt ForwardAuth (freifunkMUC).
      # Plugin: maxlerebourg/crowdsec-bouncer-traefik-plugin
      plugin:
        bouncer:
          enabled: true
          crowdsecMode: stream
          crowdsecLapiHost: crowdsec:8080
          # angepasst: Traefik-File-Provider substituiert kein ${VAR}. Go-Templating.
          # Die Variable muss im Traefik-Container als Env ankommen (compose/traefik.yml).
          crowdsecLapiKey: '{{ env "BOUNCER_KEY_TRAEFIK" }}'
          crowdsecAppsecEnabled: true
          crowdsecAppsecHost: crowdsec:7422
          crowdsecAppsecFailureBlock: true
          crowdsecAppsecUnreachableBlock: true
          forwardedHeadersTrustedIPs:
            # Cloudflare IPv4 - Quelle: https://www.cloudflare.com/ips-v4
            - "173.245.48.0/20"
            - "103.21.244.0/22"
            - "103.22.200.0/22"
            - "103.31.4.0/22"
            - "141.101.64.0/18"
            - "108.162.192.0/18"
            - "190.93.240.0/20"
            - "188.114.96.0/20"
            - "197.234.240.0/22"
            - "198.41.128.0/17"
            - "162.158.0.0/15"
            - "104.16.0.0/13"
            - "104.24.0.0/14"
            - "172.64.0.0/13"
            - "131.0.72.0/22"
            # Cloudflare IPv6 - Quelle: https://www.cloudflare.com/ips-v6
            - "2400:cb00::/32"
            - "2606:4700::/32"
            - "2803:f800::/32"
            - "2405:b500::/32"
            - "2405:8100::/32"
            - "2a06:98c0::/29"
            - "2c0f:f248::/32"
          forwardedHeadersCustomName: "CF-Connecting-IP"

ABSOLUTE_PATH=${PWD}
TZ=Europe/Berlin
SERVICES_TRAEFIK_LABELS_TRAEFIK_HOST=HOST(`traefik.yourdomain.com`)

# angepasst: Image + Version explizit statt Compose-Fallback
SERVICES_TRAEFIK_IMAGE=traefik
SERVICES_TRAEFIK_IMAGE_VERSION=3.7.13

# angepasst: LAPI-Keys für den nativen Plugin-Bouncer (Traefik) und den
# firewall-bouncer. Pro Host neu generieren, nicht kopieren – siehe README.
BOUNCER_KEY_TRAEFIK=
BOUNCER_KEY_FIREWALL=

# angepasst: DNS-01 via Cloudflare API-Token (scoped).
# Token benötigt Zone:Read + DNS:Edit, Scope: alle Zonen.
# NICHT CF_API_EMAIL/CF_API_KEY (Global API Key) verwenden – lego bevorzugt
# den Global Key und ignoriert das Token dann stillschweigend. Ebenso existiert
# keine Variable CF_DNS_API_KEY. Details im README.
CF_DNS_API_TOKEN=
